# Copy to .env for local Supabase (never commit real secrets)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override kroger-deals URL (default: {SUPABASE_URL}/functions/v1/kroger-deals)
# Kroger credentials stay on Supabase Edge Function secrets only — no client Kroger env vars.
EXPO_PUBLIC_KROGER_PROXY_URL=

# Recipe discovery — no API key here; set RECIPEAPI_KEY on Supabase Edge Function recipeapi-proxy
# Optional: override proxy URL (default: {SUPABASE_URL}/functions/v1/recipeapi-proxy)
EXPO_PUBLIC_RECIPEAPI_PROXY_URL=

# Pantry photo scan — Gemini key stays on Supabase Edge Function pantry-vision (GEMINI_API_KEY secret)
# Optional: override proxy URL (default: {SUPABASE_URL}/functions/v1/pantry-vision)
EXPO_PUBLIC_PANTRY_VISION_URL=

# USDA nutrition — API key stays on Supabase Edge Function usda-proxy (USDA_API_KEY secret).
# No client env var; optional device key in Admin for direct DEMO_KEY fallback only.
