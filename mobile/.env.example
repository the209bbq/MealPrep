# Copy to .env for local Supabase (never commit real secrets)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Smart Shop — Kroger public client id only (secret stays on Supabase Edge Function)
EXPO_PUBLIC_KROGER_CLIENT_ID=
# Optional: override Kroger proxy URL (default: {SUPABASE_URL}/functions/v1/kroger-deals)
EXPO_PUBLIC_KROGER_PROXY_URL=

# Recipe discovery — no API key here; set RECIPEAPI_KEY on Supabase Edge Function recipeapi-proxy
# Optional: override proxy URL (default: {SUPABASE_URL}/functions/v1/recipeapi-proxy)
EXPO_PUBLIC_RECIPEAPI_PROXY_URL=
